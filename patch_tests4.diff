+func TestToDarwin(t *testing.T) {
+	input := "helloWorld"
+	result, err := ToDarwin(input)
+	if err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+	expected := "Hello_World"
+	if result != expected {
+		t.Errorf("Expected %s, got %s", expected, result)
+	}
+}
